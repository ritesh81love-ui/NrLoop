      <input type="text" id="f-category-suggestion" placeholder="e.g. mobile mechanic, tiling">
    </div>
  `;
}

function wireStep1Interactions(){
  document.querySelectorAll('[data-suburb]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('[data-suburb]').forEach(b=>b.classList.remove('selected'));
      btn.classList.add('selected');
      const otherInput = document.getElementById('f-suburb-other');
      if(btn.dataset.suburb === 'Other'){
        otherInput.style.display = 'block';
        otherInput.focus();
        state.suburb = otherInput.value.trim();
      } else {
        otherInput.style.display = 'none';
        state.suburb = btn.dataset.suburb;
      }
    });
  });
  const suburbOtherInput = document.getElementById('f-suburb-other');
  if(suburbOtherInput){
    suburbOtherInput.addEventListener('input', ()=>{ state.suburb = suburbOtherInput.value.trim(); });
  }

  document.querySelectorAll('[data-bizsuburb]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      document.querySelectorAll('[data-bizsuburb]').forEach(b=>b.classList.remove('selected'));
      btn.classList.add('selected');
      const otherInput = document.getElementById('f-bizsuburb-other');
      if(btn.dataset.bizsuburb === 'Other'){
        otherInput.style.display = 'block';
        otherInput.focus();
        state.bizSuburb = otherInput.value.trim();
      } else {
        otherInput.style.display = 'none';
        state.bizSuburb = btn.dataset.bizsuburb;
      }
    });
  });
  const bizSuburbOtherInput = document.getElementById('f-bizsuburb-other');
  if(bizSuburbOtherInput){
    bizSuburbOtherInput.addEventListener('input', ()=>{ state.bizSuburb = bizSuburbOtherInput.value.trim(); });
  }
  document.querySelectorAll('[data-service]').forEach(card=>{
    card.addEventListener('click', ()=>{
      const key = card.dataset.service;
      if(state.services.has(key)){ state.services.delete(key); card.classList.remove('selected'); }
      else{ state.services.add(key); card.classList.add('selected'); }
    });
  });
}

function initStars(){
  state.rating = 0;
  const captions = ["", "Not really", "Maybe", "Probably", "Very likely", "Definitely"];
  const row = document.getElementById('star-row');
  row.innerHTML = [1,2,3,4,5].map(n=>`<button type="button" class="star" data-star="${n}">★</button>`).join('');
  const stars = document.querySelectorAll('[data-star]');
  stars.forEach(star=>{
    star.addEventListener('click', ()=>{
      state.rating = parseInt(star.dataset.star);
      stars.forEach(s=> s.classList.toggle('active', parseInt(s.dataset.star) <= state.rating));
      document.getElementById('star-caption').textContent = captions[state.rating];
    });
  });
  document.getElementById('star-caption').textContent = 'Tap a star to answer';
}

/* ============ STEP NAV / VALIDATION ============ */
let totalSteps = 2;

function updateStepChrome(n){
  for(let i=1;i<=3;i++){
    const stepEl = document.querySelector(`#role-form .step[data-step="${i}"]`);
    if(!stepEl) continue;
    const countEl = stepEl.querySelector('.step-count');
    if(countEl) countEl.textContent = `STEP ${i} OF ${totalSteps}`;
    const dotsEl = stepEl.querySelector('.step-dots');
    if(dotsEl){
      let dots = '';
      for(let d=1; d<=totalSteps; d++){
        if(d<n) dots += '<span class="done"></span>';
        else if(d===n) dots += '<span class="current"></span>';
        else dots += '<span></span>';
      }
      dotsEl.innerHTML = dots;
    }
  }
}

function goToStep(n){
  document.querySelectorAll('#role-form .step').forEach(s=> s.style.display='none');
  document.querySelector(`#role-form .step[data-step="${n}"]`).style.display='block';
  document.getElementById('progress-fill').style.width = (n/totalSteps*100) + '%';
  updateStepChrome(n);
}

function validateStep1(){
  const role = state.role;
  let ok = true;
  if(role === 'customer' || role === 'both'){
    const name = document.getElementById('f-name').value.trim();
    const email = document.getElementById('f-email').value.trim();
    if(!(name.length>1 && /\S+@\S+\.\S+/.test(email))) ok = false;
    if(ok){
      state.name = name; state.email = email;
      state.serviceSuggestion = document.getElementById('f-service-suggestion').value.trim();
    }
  }
  if(role === 'business' || role === 'both'){
    const bizname = document.getElementById('f-bizname').value.trim();
    const bizemail = document.getElementById('f-bizemail').value.trim();
    if(!(bizname.length>1 && /\S+@\S+\.\S+/.test(bizemail))) ok = false;
    if(ok){
      state.bizName = bizname; state.bizEmail = bizemail;
      state.bizCategory = document.getElementById('f-bizcat').value;
      state.bizVolume = document.getElementById('f-bizvolume').value;
      state.categorySuggestion = document.getElementById('f-category-suggestion').value.trim();
      if(role === 'business' && !state.name) state.name = bizname;
    }
  }
  document.getElementById('err-1').classList.toggle('show', !ok);
  return ok;
}

function safeScrollTo(el){
  try{
    if(el && typeof el.scrollIntoView === 'function'){
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  } catch(err){
    // ignore — some browsers/webviews don't support smooth scroll options
  }
}

function validateStep2(){
  const rankRequired = state.role !== 'business';
  const rankOk = !rankRequired || state.priorityRank.length === PRIORITY_ITEMS.length;
  const concernOk = state.concerns.size > 0 &&
    (!state.concerns.has('Other') || state.concernOther.trim().length > 0);
  const ok = state.rating > 0 && concernOk && rankOk;
  const err = document.getElementById('err-2');
  err.textContent = !state.rating ? 'Give it a star rating before you submit.'
    : (state.concerns.size === 0) ? 'Pick at least one before you submit.'
    : (state.concerns.has('Other') && !concernOk) ? 'Add a quick note for "Other" before you submit.'
    : !rankOk ? 'Rank all four priorities before you submit.'
    : '';
  err.classList.toggle('show', !ok);
  if(!ok) safeScrollTo(err);
  return ok;
}

/* ============ SUBMIT ============ */
document.getElementById('role-form').addEventListener('submit', (e)=>{
  e.preventDefault();
  if(!validateStep2()) return;

  interestCount += 1;
  const regNumber = interestCount + 1;
  const cfg = ROLE_CONTENT[state.role];
  const firstName = (state.name || state.bizName || 'there').split(' ')[0];

  const reasonLabels = [...state.reasons].map(idx => cfg.reasonOptions[idx]).join('; ');
  const serviceLabels = SERVICES.filter(s=>state.services.has(s.key)).map(s=>s.label).join(', ');
  submitToGoogleSheet({
    role: state.role,
    name: state.name || '',
    email: state.email || '',
    suburb: state.suburb || '',
    services: serviceLabels,
    serviceSuggestion: state.serviceSuggestion || '',
    bizName: state.bizName || '',
    bizEmail: state.bizEmail || '',
    bizCategory: state.bizCategory || '',
    bizSuburb: state.bizSuburb || '',
    bizVolume: state.bizVolume || '',
    categorySuggestion: state.categorySuggestion || '',
    rating: state.rating,
    reasons: reasonLabels,
    concern: Array.from(state.concerns).map(label=>
      label === 'Other' && state.concernOther.trim()
        ? `Other: ${state.concernOther.trim()}`
        : label
    ).join(', '),
    priorityRank: state.priorityRank.map((idx,pos)=>`${pos+1}) ${PRIORITY_ITEMS[idx]}`).join('; '),
    regNumber: regNumber
  });

  document.getElementById('confirm-ring').innerHTML = ringSvg(1, 84, 8, 'var(--fern)');
  document.getElementById('reg-number').textContent = '#' + regNumber;
  document.getElementById('confirm-heading').textContent = cfg.confirmHeadingTemplate(firstName);
  document.getElementById('confirm-sub').textContent = cfg.confirmSub;
  document.getElementById('benefits-title').textContent = cfg.benefitsTitle;
  document.getElementById('benefit-grid').innerHTML = cfg.benefits.map(b=>`
    <div class="benefit-card">
      <div class="tier-icon" style="background:var(--${b.cls==='business'?'gold-soft':b.cls==='both'?'brick-soft':'fern-soft'});">${b.icon}</div>
      <b>${b.title}</b><span>${b.text}</span>
    </div>`).join('');

  showView('view-confirm');
});

/* ============ RESTART ============ */
document.getElementById('restart-btn').addEventListener('click', ()=>{
  state = { role:null, name:"", email:"", suburb:null, services:new Set(),
    bizName:"", bizCategory:"", bizVolume:"", rating:0, reasons:new Set(),
    concerns:new Set(), concernOther:"", priorityRank:[] };
  selectedRoles = new Set();
  document.querySelectorAll('[data-toggle-role]').forEach(c=>c.classList.remove('selected'));
  updateRoleContinueState();
  showView('view-landing');
});
