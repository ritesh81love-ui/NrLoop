    `<h3>${cfg.heading}</h3><p class="hint">${cfg.lede}</p>` + step1Html +
    `<div class="error-msg" id="err-1">Fill in the required fields to continue.</div>
     <div class="step-actions"><button type="button" class="btn full grow" id="to-step2">Continue</button></div>`;

  wireStep1Interactions();
  initStars();
  document.getElementById('to-step2').addEventListener('click', ()=>{
    if(validateStep1()) goToStep(2);
  });
  document.getElementById('back-to-step1').addEventListener('click', ()=> goToStep(1));
}

function customerStep1(compact){
