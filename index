    <div class="field"><label>Email</label><input type="email" id="f-email" placeholder="you@email.com"></div>
    <div class="field">
      <label>Which area are you in?</label>
      <div class="chip-row" id="suburb-chips">
        ${SUBURBS.map(s=>`<button type="button" class="chip-select" data-suburb="${s}">${s}</button>`).join('')}
      </div>
      <input type="text" id="f-suburb-other" class="other-suburb-input" style="display:none;" placeholder="Type your suburb">
    </div>
    <div class="field">
      <label>What would you use it for?</label>
      <div class="service-cards" id="service-cards">
        ${SERVICES.map(s=>`
          <button type="button" class="service-card" data-service="${s.key}">
            <span class="check">✓</span><span class="icon">${s.icon}</span><b>${s.label}</b>
          </button>`).join('')}
